{
  "app": {
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "storeFile": "./signing/debug.p12",
          "storePassword": "000000193B868CE49F76D6433ADA71F76A01DCBA0682E9D9005876729EE853F53BE8211DE4513FCCE4",
          "keyAlias": "key",
